{
  "plugin": "org.smartide.plugin.git",
  "run": "echo 'change command from .si.json file'",
  "intelligence": {
    ".gradle": {
      "enabled": true,
      "run": "groovy-language-server"
    },
    ".sh": {
      "enabled": true,
      "run": "bash-language-server start"
    },
    ".xml": {
      "enabled": true,
      "run": "lemminx"
    },
    ".yml": {
      "enabled": true,
      "run": "yaml-language-server --stdio"
    },
    ".properties": {
      "enabled": true,
      "run": "lemminx"
    }
  }
}